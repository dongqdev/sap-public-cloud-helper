set -e

echo "==> 시크릿 유출 체크"
if git diff --cached --name-only | grep -qE '(^|/)\.env(\..*)?$'; then
  echo "!! .env 계열 파일이 스테이징되어 있습니다 — 실제 자격증명을 커밋하려는 게 아니라면 git reset으로 빼세요."
  exit 1
fi
if git diff --cached | grep -qE 'sk-ant-[A-Za-z0-9_-]{10,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
  echo "!! diff에서 알려진 비밀키 패턴이 감지됐습니다. 실수로 자격증명을 커밋하려는 건 아닌지 확인하세요."
  exit 1
fi

echo "==> 포매팅 (lint-staged)"
npx lint-staged

echo "==> 구문 체크 (스테이징된 .js 파일)"
for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.js'); do
  [ -f "$f" ] && node --check "$f"
done
